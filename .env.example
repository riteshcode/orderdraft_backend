# =========================================================
#  OrderDraft backend settings  (copy to .env)
# =========================================================

# ---------- App ----------
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# 64 char random:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Optional alag key for encrypting Xero tokens / API secrets (Fernet key)
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Ye email register/login karte hi Super Admin ban jayega
SUPERADMIN_EMAILS=you@example.com

# ---------- Database ----------
# Main DB: tenants registry, users/login, plans, usage.
DATABASE_URL=sqlite:///./orderdraft.db
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/orderdraft
# Har client ka apna database ({db_name} = od_t_<id>). Khali = same server / ./tenant_dbs/ (SQLite).
# MySQL user ko CREATE DATABASE permission chahiye.
# TENANT_DATABASE_URL=mysql+pymysql://root:@localhost:3306/{db_name}
TENANT_DB_PREFIX=od_t_
AUTO_MIGRATE=true

# ---------- Background jobs ----------
# thread (local/Windows) | rq (Linux server + Redis + "python -m app.worker")
JOBS_MODE=thread
REDIS_URL=redis://localhost:6379/0
# Production mein false karke alag chalao: python -m app.scheduler
RUN_SCHEDULER_IN_APP=true

STORAGE_DIR=./storage

# ---------- AI ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-AU

# ---------- Inbound email (Postmark inbound webhook) ----------
INBOUND_DOMAIN=orders.yourapp.com
INBOUND_WEBHOOK_USER=postmark
INBOUND_WEBHOOK_PASS=change-me

# ---------- Outbound email (invites, password reset, invoices) ----------
# Khali = emails sirf terminal mein print honge
POSTMARK_SERVER_TOKEN=
MAIL_FROM=OrderDraft <no-reply@yourapp.com>
MAIL_PLATFORM_NAME=OrderDraft
# Client apne domain se email bheje (Settings -> Email): Postmark -> Account -> API Tokens (ACCOUNT token)
# Khali = dev mode, DNS records placeholder; tab tak emails "Client via OrderDraft" <MAIL_FROM> se jaate hain
POSTMARK_ACCOUNT_TOKEN=

# ---------- Accounting software ----------
# Har client apna Xero / QuickBooks / MYOB account connect karta hai (ek client = ek software).
# Platform ka ek app har software ke developer portal mein banao. Redirect URI:
#   {APP_URL}/integrations/xero/callback   /integrations/quickbooks/callback   /integrations/myob/callback

# ---------- Xero ----------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/integrations/xero/callback
# Default = granular scopes (March 2026 ke baad bane Web apps). Purana app sirf broad scopes allow kare to:
# XERO_SCOPES=offline_access accounting.transactions accounting.contacts accounting.settings
# XERO_SCOPES=offline_access accounting.invoices accounting.contacts accounting.settings
XERO_WEBHOOK_KEY=

# ---------- QuickBooks Online ----------
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/integrations/quickbooks/callback
# sandbox (testing) | production
QUICKBOOKS_ENVIRONMENT=sandbox
# Webhooks -> verifier token (invoice status updates)
QUICKBOOKS_WEBHOOK_VERIFIER=

# ---------- MYOB Business / AccountRight ----------
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
MYOB_REDIRECT_URI=http://localhost:8000/integrations/myob/callback
# Apne MYOB app ke scopes se match karo
MYOB_SCOPES=CompanyFile

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=14
HARD_LIMIT_PERCENT=120

# ---------- Matching ----------
MATCH_AUTO_THRESHOLD=85
MATCH_MIN_THRESHOLD=55

# ---------- Logs / PDFs ----------
# Request + error log (JSON lines, daily rotation). Support: grep <reference> logs/app.log*
LOG_DIR=./logs
LOG_KEEP_DAYS=30
# Chinese/Japanese/Korean text in PDFs (optional): path to a CJK .ttf/.ttc, e.g. /usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
PDF_CJK_FONT=

# ---------- Customer portal app notifications (Web Push) ----------
# python -m app.cli vapid-keys   (generate once, keep private key secret)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com
